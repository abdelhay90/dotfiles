#!/bin/bash
# Enable once per clone: git config core.hooksPath .githooks (bootstrap.sh does it).
# Blocks staged secrets and shellcheck warnings in the staged shell files.
set -e
cd "$(git rev-parse --show-toplevel)"

if git diff --cached --name-only | grep -qx 'bash/.secrets'; then
    echo "pre-commit: bash/.secrets is staged (git add -f?). Unstage it." >&2
    exit 1
fi

# known token shapes, or NAME_(TOKEN|SECRET|KEY|PASSWORD)="<16+ chars>" assignments
if git diff --cached -U0 -- . ':!.githooks' |
    grep -E '^\+.*(sk-ant-|ghp_[A-Za-z0-9]{20}|AKIA[0-9A-Z]{16}|(TOKEN|SECRET|API_?KEY|PASSWORD)=["'"'"']?[A-Za-z0-9_./+-]{16,})'; then
    echo "pre-commit: possible secret staged (above). Put it in bash/.secrets." >&2
    exit 1
fi

# lint staged content (not the working tree), incl. this hook
rc=0
for f in $(git diff --cached --name-only --diff-filter=ACM | grep -E '^bash/\.[a-z_.]+$|\.sh$|^\.githooks/' | grep -vE '\.hints$'); do
    if ! out=$(git show ":$f" | shellcheck -s bash --severity=warning -e SC1091,SC2148 --format=gcc -); then
        echo "${out//<stdin>/$f}" >&2
        rc=1
    fi
done
exit $rc
