#!/bin/bash
# Enable once per clone: git config core.hooksPath .githooks
# Blocks committed secrets and shellcheck warnings in the shell files.
set -e
cd "$(git rev-parse --show-toplevel)"

if git diff --cached -U0 -- . ':!.githooks' | grep -E '^\+.*(sk-ant-|ghp_[A-Za-z0-9]{20}|AKIA[0-9A-Z]{16})'; then
    echo "pre-commit: possible secret staged (above). Put it in bash/.secrets." >&2
    exit 1
fi

files=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^bash/\.[a-z_]+$|\.sh$' | grep -vE 'git-completion|\.hints$' || true)
[ -z "$files" ] && exit 0
# shellcheck disable=SC2086
shellcheck -s bash --severity=warning -e SC1091,SC2148 $files
