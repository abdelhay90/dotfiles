#!/bin/bash

# path_add DIR [after]: prepend (or append) DIR to PATH if it exists and is not there yet.
# Safe to re-source (rl) without PATH growing.
path_add() {
    [ -d "$1" ] || return 0
    case ":$PATH:" in *":$1:"*) return 0 ;; esac
    if [ "$2" = after ]; then PATH="$PATH:$1"; else PATH="$1:$PATH"; fi
    export PATH
}

# Jeroen Janssens' jumper functions
# http://jeroenjanssens.com/2013/08/16/quickly-navigate-your-filesystem-from-the-command-line.html
# with some modifications: completion, show marks if no args given, make marks work on OS X 10.8.
export MARKPATH=$HOME/.marks

function j {
    if [ -z "$1" ]; then
        marks
    else
        cd -P "$MARKPATH/$1" 2>/dev/null || echo "No such mark: $1"
    fi
}

function mark { 
    mkdir -p "$MARKPATH"; ln -s "$PWD" "$MARKPATH/$1"
}

function unmark { 
    rm -i "$MARKPATH/$1" 
}

function marks {
    ls -l $MARKPATH | sed 's/  / /g' | cut -d' ' -f9- && echo
}

# Create a new directory and enter it
function md() {
  mkdir -p "$1" && cd "$1" || return
}

# clean the current directory (confirms, shows path, refuses $HOME and /)
function clean() {
    if [ "$PWD" = "$HOME" ] || [ "$PWD" = "/" ]; then
        echo "refusing to clean $PWD"; return 1
    fi
    local yn
    read -r -p "remove everything in $PWD? (y/N) " yn
    if [ "$yn" = "y" ]; then
        find . -mindepth 1 -delete
    fi
}

# check file size
function fs() {
    du -sh "${1}" | awk '{print $1}'
}

# check processes using a port
function port() {
    lsof -iTCP:"$1" -sTCP:LISTEN
}

# credit: http://nparikh.org/notes/zshrc.txt
# Usage: extract <file>
# Description: extracts archived files / mounts disk images
# Note: .dmg/hdiutil is Mac OS X-specific.
extract () {
    if [ -f "$1" ]; then
        case "$1" in
            *.tar.bz2)  tar -jxvf "$1"                        ;;
            *.tar.gz)   tar -zxvf "$1"                        ;;
            *.bz2)      bunzip2 "$1"                          ;;
            *.dmg)      hdiutil mount "$1"                    ;;
            *.gz)       gunzip "$1"                           ;;
            *.tar)      tar -xvf "$1"                         ;;
            *.tbz2)     tar -jxvf "$1"                        ;;
            *.tgz)      tar -zxvf "$1"                        ;;
            *.zip)      unzip "$1"                            ;;
            *.ZIP)      unzip "$1"                            ;;
            *.pax)      pax -r < "$1"                     ;;
            *.pax.Z)    uncompress "$1" --stdout | pax -r     ;;
            *.Z)        uncompress "$1"                       ;;
            *)          echo "$1 cannot be extracted/mounted via extract()" ;;
        esac
    else
        echo "$1 is not a valid file"
    fi
}

# delete local branches whose remote is gone; pass -D to force (default -d)
function gclean() {
  git fetch -ap || return
  git branch -vv | awk '/: gone]/{print $1}' | xargs -r git branch "${1:--d}"
}

function prune_git_history() {
    echo "prunnig and removing unrefrenced blobs from local history."
    echo "git gc --prune=now"
    git gc --prune=now
    echo "deleteing branches references to remote branches that do not exist."
    echo "git remote prune origin"
    git remote prune origin
    echo "Done."
}

function line () {
    echo "----------------------------------------"
}

# usage: rename_git_branch <old> <new> [-r]   (-r also deletes the old remote branch)
function rename_git_branch() {
    if [ $# -lt 2 ]; then echo "usage: rename_git_branch <old> <new> [-r]"; return 1; fi
    echo "git checkout $1"
    git checkout "$1" || return
    line
    echo "git branch -m $2"
    git branch -m "$2" || return
    line
    echo "git push origin -u $2"
    git push origin -u "$2" || return
    line
    if [ "$3" = "-r" ]; then
        echo "git push origin --delete $1"
        git push origin --delete "$1" || return
        line
    fi
    echo "Done!"
}

function update_bff_api() {
    local sep="-------------------------------------------------------------"
    echo "pnpm generate:clean"; pnpm generate:clean || return; sleep 4
    echo "$sep"
    echo "pnpm generate:auth"; pnpm generate:auth || return; sleep 4
    echo "$sep"
    echo 'update swagger.json file and remove "<>",'
    sed -i '' 's/"<>",//g' ./swagger.json || return; sleep 4
    echo "$sep"
    echo "pnpm generate:bff"; pnpm generate:bff || return; sleep 4
    echo "$sep"
    echo "Happy hacking!"
}

