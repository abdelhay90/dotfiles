#!/bin/bash

# Configs for development machine
[[ $- == *i* ]] && echo 'OSX profile loaded.'

# LSCOLORS designators (order of attributes: dir, symlink, socket, pipe, executable,
# block special, char special, setuid exec, setgid exec, sticky+writable dir, writable dir)
#   a black  b red  c green  d brown  e blue  f magenta  g cyan  h light grey
#   capital = bold variant, x = default fg/bg
# A color scheme that loosely matches Ubuntu's default scheme:
export CLICOLOR=1
export LSCOLORS=ExGxdxDxCxegedhbadaced

# JDK: with jenv, `java` comes from its shims (on PATH via ~/.zshrc) and JAVA_HOME follows jenv's
# global version (read from a file: no fork). ponytail: per-directory .java-version files are not
# reflected in JAVA_HOME; run `jenv shell`/full `jenv init` if a tool needs that.
if [ -d "$HOME/.jenv/versions" ]; then
    _jv=$(<"$HOME/.jenv/version") 2>/dev/null
    [ -n "$_jv" ] && [ -d "$HOME/.jenv/versions/$_jv" ] && export JAVA_HOME="$HOME/.jenv/versions/$_jv"
    unset _jv
elif [ -d /Library/Java/JavaVirtualMachines/openjdk-21.jdk/Contents/Home ]; then
    export JAVA_HOME=/Library/Java/JavaVirtualMachines/openjdk-21.jdk/Contents/Home
    path_add "$JAVA_HOME/bin" after
fi

# Homebrew keg-only tools (only added if installed)
# (JDKs are left to jenv; a keg-only openjdk here would shadow its shims)
for _k in libpq gradle@8; do
    path_add "${HOMEBREW_PREFIX:-/opt/homebrew}/opt/$_k/bin"
done
unset _k

# common places
alias p="cd ~/Personal"
alias mw="cd ~/Work"

# recursively delete .DS_Store
alias dsstore="find . -name '*.DS_Store' -type f -ls -delete"

# recursively delete node_modules
alias nodemodules="find . -name node_modules -type d -prune -exec rm -rf '{}' +"

# copy stdin to clipboard without the trailing newline (mimics linux xclip)
xclip() {
  printf %s "$(cat)" | pbcopy
}
