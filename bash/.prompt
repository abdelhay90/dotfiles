#!/bin/bash

if [[ $COLORTERM = gnome-* && $TERM = xterm ]] && infocmp gnome-256color >/dev/null 2>&1; then
    export TERM=gnome-256color
elif [[ $TERM = xterm ]] && infocmp xterm-256color >/dev/null 2>&1; then
    export TERM=xterm-256color
fi

LIGHTRED=$(tput setaf 9 2>/dev/null)
ORANGE=$(tput setaf 172 2>/dev/null)
PURPLE=$(tput setaf 141 2>/dev/null)
RESET=$(tput sgr0 2>/dev/null)

# GIT_OPTIONAL_LOCKS=0: never take the index lock from the prompt (avoids index.lock races)
_pgit() { GIT_OPTIONAL_LOCKS=0 git "$@"; }

function git_info() {
    # not in a git repo -> nothing
    _pgit rev-parse --is-inside-work-tree &>/dev/null || return

    local branch
    branch=$(_pgit symbolic-ref --short HEAD 2>/dev/null)
    # detached HEAD
    [ -z "$branch" ] && branch=$(_pgit rev-parse --short HEAD 2>/dev/null)

    # dirty = tracked files changed. Much faster than `status` in huge repos;
    # ponytail: ignores untracked files, switch to `git status --porcelain` if you want them.
    # (`_pgit diff` refreshes stat info; `diff-index` alone reports false positives after touch/checkout)
    # (no commits yet -> HEAD missing -> not dirty)
    local dirty=""
    if _pgit rev-parse -q --verify HEAD >/dev/null 2>&1; then
        _pgit diff --quiet HEAD -- 2>/dev/null || dirty="${LIGHTRED}*"
    fi

    echo " ${PURPLE}(${branch}${dirty}${PURPLE})"
}

# Only show user@host over SSH
function usernamehost() {
    if [ -n "$SSH_TTY" ]; then
        echo "${PURPLE}$USER@$HOSTNAME${RESET} "
    fi
}

if [ -n "$ZSH_VERSION" ]; then
    setopt PROMPT_SUBST
    # %~ = cwd, %1d = basename; %{ %} marks zero-width escapes (window/tab title)
    term_title=$'%{\033]2;%~\007\033]1;%1d\007%}'
    # single quotes: $(...) and $ORANGE are expanded at prompt time, not now
    PS1="${term_title}"'$(usernamehost)%{$ORANGE%}%~$(git_info)%{$RESET%}
$ '
    unset term_title
else
    # \w = cwd, \W = basename; \[ \] marks zero-width escapes
    TITLEBAR="\[\033]2;\w\007\]\[\033]1;\W\007\]"
    PS1="${TITLEBAR}\$(usernamehost)\[$ORANGE\]\w\$(git_info)\[$RESET\]\n\$ "
fi
