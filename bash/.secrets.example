#!/bin/bash
# Copy to bash/.secrets (git-ignored) and fill in your own values:
#   cp bash/.secrets.example bash/.secrets && chmod 600 bash/.secrets
# Sourced first by bash/.profile. Put every token / API key here, never in tracked files.
#
# Prefer scoping a secret to the one command that needs it, instead of `export`ing it into
# every process (npm postinstall scripts, docker, ...) that inherits your environment:

# _claude_oauth_token=""   # generate with: claude setup-token
# claude() { CLAUDE_CODE_OAUTH_TOKEN="$_claude_oauth_token" command claude "$@"; }

# Plain exports still work if you really need a variable everywhere:
# export SOME_API_KEY=""
